{
  "expo": {
    "name": "Black Bubble Wash",
    "slug": "black-bubble-wash",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.blackbubblewash.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#0b0b0c"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0c",
          "imageWidth": 200
        }
      ]
    ]
  }
}
